# =====================================================================
#  ACL do broker do espaço: ubs. O "usuário" é o CN do certificado.
#  Tópicos: va/ubs/telemetry/<device_id>  e  va/ubs/cmd/<device_id>
# =====================================================================

# Qualquer identidade autenticada (dispositivos): só publica a PRÓPRIA
# telemetria e só lê os PRÓPRIOS comandos.
pattern write va/ubs/telemetry/%u
pattern read  va/ubs/cmd/%u

# Auditor de laboratório: somente leitura (testes e evidências).
user lab-auditor
topic read va/#

# Agente da borda: lê a telemetria do espaço, envia comandos locais
# (ex.: liberar porta, ligar bomba) e publica alarmes locais.
user edge-ubs-agent
topic read  va/ubs/telemetry/#
topic write va/ubs/cmd/#
topic write va/ubs/alarm/#
