# =====================================================================
#  ACL do broker do espaço: horta. O "usuário" é o CN do certificado.
#  Tópicos: va/horta/telemetry/<device_id>  e  va/horta/cmd/<device_id>
# =====================================================================

# Qualquer identidade autenticada (dispositivos): só publica a PRÓPRIA
# telemetria e só lê os PRÓPRIOS comandos.
pattern write va/horta/telemetry/%u
pattern read  va/horta/cmd/%u

# Auditor de laboratório: somente leitura (testes e evidências).
user lab-auditor
topic read va/#
