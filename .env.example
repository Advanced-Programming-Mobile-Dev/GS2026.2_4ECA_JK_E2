# Copie para .env e troque TODOS os valores (o .env nunca vai para o git).
# Windows:  copy .env.example .env   e edite com o Bloco de Notas.

# Linux: UID/GID do seu usuário (id -u ; id -g). No Windows pode deixar 1000.
HOST_UID=1000
HOST_GID=1000

# Banco de dados da nuvem
POSTGRES_PASSWORD=troque-esta-senha-admin
INGEST_DB_PASSWORD=troque-esta-senha-ingest
PAINEL_DB_PASSWORD=troque-esta-senha-painel

# Segredo da pseudonimização dos crachás (LGPD). Use um texto longo e aleatório.
BADGE_PEPPER=troque-por-um-texto-longo-e-aleatorio

# Chave que assina as sessões do painel. Use um texto longo e aleatório.
PAINEL_SECRET_KEY=troque-por-outro-texto-longo-e-aleatorio
